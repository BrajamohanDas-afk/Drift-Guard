DATABASE_URL=postgresql+asyncpg://drift:drift@localhost:5433/driftguard
ALEMBIC_DATABASE_URL=postgresql+psycopg2://drift:drift@localhost:5433/driftguard
REDIS_URL=redis://:local-dev-redis-password@localhost:6379/0
REDIS_PASSWORD=local-dev-redis-password
SECRET_KEY=local-dev-secret-key-replace-before-shared-use
GITHUB_TOKEN=
SQL_ECHO=false
API_KEY=dg_local_dev_api_key_replace_before_shared_use
WORKER_QUEUE_NAME=drift-guard
HEAVY_ENDPOINT_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
WORKER_QUEUE_MAX_DEPTH=1000
PUBLIC_API_DOCS_ENABLED=true
NIGHTLY_SCAN_CRON_ENABLED=true
NIGHTLY_SCAN_CRON_HOUR_UTC=2
NIGHTLY_SCAN_CRON_MINUTE=0
NOTIFICATION_CHANNELS=
NOTIFICATION_MIN_SEVERITY=low
NOTIFICATION_TIMEOUT_SECONDS=5
SLACK_WEBHOOK_URL=
COMPLETION_WEBHOOK_URL=
EMAIL_SINK_PATH=./tmp/drift-guard-notifications.jsonl

# Use this database for host-side integration tests so the DB guard can safely
# truncate test data.
TEST_DATABASE_URL=postgresql+asyncpg://drift:drift@localhost:5433/driftguard_test
TEST_ALEMBIC_DATABASE_URL=postgresql+psycopg2://drift:drift@localhost:5433/driftguard_test

INCIDENTIO_API_TOKEN=
INCIDENTIO_CATALOG_TYPE_ID=
KUBERNETES_API_URL=
KUBERNETES_BEARER_TOKEN=
KUBERNETES_VERIFY_SSL=true
