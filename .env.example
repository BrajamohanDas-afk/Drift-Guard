DATABASE_URL=postgresql+asyncpg://drift:drift@postgres:5432/driftguard
ALEMBIC_DATABASE_URL=postgresql+psycopg2://drift:drift@localhost:5432/driftguard
REDIS_URL=redis://redis:6379
SECRET_KEY=your-secret-key-here
GITHUB_TOKEN=your-github-token-here
SQL_ECHO=false
API_KEY=change-me

# Optional: incident.io collector token
# - Leave empty for local development (collector returns structured "not configured")
# - Unit tests use mocked responses and do not require live incident.io credentials
# - Required only for production/live drift detection against incident.io
# - Create/manage API keys: https://app.incident.io/settings/api-keys
INCIDENTIO_API_TOKEN=

# Optional: incident.io catalog type id for services
# - Use this to scope lookups to a specific catalog type (recommended in production)
INCIDENTIO_CATALOG_TYPE_ID=

# Optional: Kubernetes collector configuration
# - Leave empty for local development/testing if not using live cluster checks
KUBERNETES_API_URL=
KUBERNETES_BEARER_TOKEN=
KUBERNETES_VERIFY_SSL=true
